<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <style>
      /* max-width指定を解釈しない一部クライアント向けのフォールバック */
      @media only screen and (max-width: 520px) {
        .email-container { width: 100% !important; }
        .email-body, .email-header, .email-footer { padding-left: 20px !important; padding-right: 20px !important; }
      }
    </style>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <style>
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    </style>
    <![endif]-->
  </head>

  <body style="margin:0; padding:0; background-color:#f8fafc;" bgcolor="#f8fafc">
    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color:#f8fafc;" bgcolor="#f8fafc">
      <tr>
        <td align="center" style="padding:24px 16px;">
          <!--[if mso]>
          <table role="presentation" width="480" align="center" cellpadding="0" cellspacing="0"><tr><td>
          <![endif]-->
          <table role="presentation" width="480" border="0" cellpadding="0" cellspacing="0" class="email-container" style="width:480px; max-width:100%; background-color:#ffffff; border:1px solid #e2e8f0; border-radius:8px;" bgcolor="#ffffff">
            <tr>
              <td height="4" style="height:4px; font-size:0; line-height:4px; background-color:#1e293b;" bgcolor="#1e293b">&nbsp;</td>
            </tr>
            <tr>
              <td class="email-header" style="padding:24px 32px 4px; font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Helvetica Neue',Arial,sans-serif;">
                <span style="color:#1e293b; font-size:14px; font-weight:600;">お問い合わせ窓口</span>
              </td>
            </tr>
            <tr>
              <td class="email-body" style="padding:16px 32px 24px; font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Helvetica Neue',Arial,sans-serif;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td class="email-footer" style="border-top:1px solid #e2e8f0; padding:14px 32px; background-color:#f8fafc; font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Helvetica Neue',Arial,sans-serif;" bgcolor="#f8fafc">
                <span style="color:#94a3b8; font-size:12px;">本メールはお問い合わせ窓口より自動送信されています。</span>
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
